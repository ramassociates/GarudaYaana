<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="8dp"
    android:fitsSystemWindows="true">

    <!-- Status & Working Days Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/tvVehicleStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.35"
            android:text="Status: STOPPED"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDaysLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.65"
            android:text="Days Left: 26"
            android:textColor="#FFFFFF"
            android:gravity="end"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Live Net Profit & Target Gap Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="6dp"
        android:layout_marginBottom="4dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/tvLiveNetProfit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Net Profit: ₹0"
            android:textColor="#00E676"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTargetGap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Target Gap: ₹2000"
            android:textColor="#FFAB40"
            android:gravity="end"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 30-Day Daily / Monthly / Yearly Gross Target Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#263238"
        android:padding="5dp"
        android:layout_marginBottom="4dp"
        android:weightSum="3">

        <TextView
            android:id="@+id/tvDailyGrossTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Tgt: ₹0"
            android:textColor="#80DEEA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMonthlyGrossTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Monthly: ₹0"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvYearlyGrossTarget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Yearly: ₹0"
            android:textColor="#CFD8DC"
            android:gravity="end"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MOE vs Current Rate/km Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvMinReqAvg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Min Op Exp: ₹0"
            android:textColor="#FF8A80"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCurrentAvg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Curr Rate: ₹0.0/km"
            android:textColor="#40C4FF"
            android:gravity="end"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Revenue Update Row (With Platform Dropdown) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1B2631"
        android:padding="5dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spnQuickPlatform"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/etTotalRevenueInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Platform Rev (₹)"
            android:textColorHint="#B0BEC5"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:padding="4dp" />

        <Button
            android:id="@+id/btnUpdateRevenue"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Update"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Cab Telemetry Stats Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:paddingBottom="3dp">

        <TextView android:id="@+id/tvOdoMeter" android:text="Odo: 0" android:textColor="#CCCCCC" android:textSize="11sp" android:padding="2dp"/>
        <TextView android:id="@+id/tvTotalDist" android:text="Shift Km: 0.0" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp" android:padding="2dp"/>
        <TextView android:id="@+id/tvOrdersToday" android:text="Updates: 0" android:textColor="#CCCCCC" android:textSize="11sp" android:padding="2dp"/>
        <TextView android:id="@+id/tvWaitTime" android:text="Idle: 0H 0M" android:textColor="#CCCCCC" android:textSize="11sp" android:padding="2dp"/>
        <TextView android:id="@+id/tvDryRun" android:text="Dry Km: 0.0" android:textColor="#CCCCCC" android:textSize="11sp" android:padding="2dp"/>
        <TextView android:id="@+id/tvEarnings" android:text="Total Rev: ₹0" android:textColor="#FFD700" android:textSize="12sp" android:textStyle="bold" android:padding="2dp"/>
    </GridLayout>

    <!-- Running Cost (Fuel + Tyre) & Remaining Fuel Value -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingBottom="4dp">
        <TextView android:id="@+id/tvAvgFuelCons" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:text="Run Cost (Fuel+Tyre): ₹0.0/km" android:textColor="#B0BEC5" android:textSize="11sp"/>
        <TextView android:id="@+id/tvAvailFuel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.85" android:text="Rem Fuel Val: ₹0" android:textColor="#80CBC4" android:textStyle="bold" android:gravity="end" android:textSize="11sp"/>
    </LinearLayout>

    <!-- Live Platform Feasibility Summary Banner -->
    <TextView
        android:id="@+id/tvPlatformFeasibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#212121"
        android:padding="5dp"
        android:layout_marginBottom="4dp"
        android:text="PLATFORM FEASIBILITY: Add Subscription or Revenue Update"
        android:textColor="#FFF59D"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- INCLUDING PICKUP & DROP: One-Flash Offer Reference & Slots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A237E"
        android:padding="5dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvFlashOfferGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INCLUDING PICKUP &amp; DROP MAX KM -> ₹150: 0km | ₹280: 0km | ₹480: 0km | ₹500: 0km"
            android:textColor="#FFEB3B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingBottom="3dp" />

        <!-- Instant Custom Offer Fare Checker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="3dp">

            <EditText
                android:id="@+id/etFlashFareCheck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:hint="Flash Fare ₹"
                android:textColor="#FFFFFF"
                android:textColorHint="#B0BEC5"
                android:textSize="11sp"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:padding="3dp" />

            <TextView
                android:id="@+id/tvFlashFareResult"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:text="INCLUDING PICKUP &amp; DROP: Max -- km"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/tvRange1to3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1–3 km\nMin: ₹0–0\nCur: ₹0–0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:background="#283593"
                android:padding="3dp"
                android:layout_marginEnd="2dp" />

            <TextView
                android:id="@+id/tvRange4to6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4–6 km\nMin: ₹0–0\nCur: ₹0–0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:background="#283593"
                android:padding="3dp"
                android:layout_marginEnd="2dp" />

            <TextView
                android:id="@+id/tvRange7to10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="7–10 km\nMin: ₹0–0\nCur: ₹0–0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:background="#283593"
                android:padding="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:paddingBottom="3dp">

        <Button
            android:id="@+id/btnAppToggle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="App Start"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/btnTripToggle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Trip Start"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/btnExitApp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Exit"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Secondary Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:paddingBottom="4dp">

        <Button android:id="@+id/btnVehicleConfig" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="Config" android:textSize="9sp"/>
        <Button android:id="@+id/btnSubPlan" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="SubPlan" android:textSize="9sp"/>
        <Button android:id="@+id/btnExpense" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="+Exp" android:textSize="9sp"/>
        <Button android:id="@+id/btnTips" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="+Tip" android:textSize="9sp"/>
        <Button android:id="@+id/btnShareCSV" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="Share" android:textSize="9sp"/>
    </LinearLayout>

    <!-- Terminal Log ScrollView -->
    <ScrollView
        android:id="@+id/svTerminal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTerminalLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GarudaYaana Cab Feasibility Engine Ready...\n"
                android:textColor="#00FF00"
                android:textSize="10sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tvTrainData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFEB3B"
                android:textSize="10sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </ScrollView>

</LinearLayout>